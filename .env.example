ARGUS_CONNECTION_STRING=mongodb+srv://demo:demo@cluster0.mongodb.net/argus_demo

# MONGO_URI=mongodb+srv://annuvrat:arigato@cluster0.benck.mongodb.net/vedai?retryWrites=true&w=majority&appName=Cluster0
# Backend (FastAPI)
ARGUS_BACKEND_PORT=8080
ARGUS_MAX_MCP_SUBPROCESSES=10
ARGUS_MCP_IDLE_TIMEOUT_S=300
ARGUS_MCP_STARTUP_TIMEOUT_S=5
ARGUS_LOG_LEVEL=INFO
ARGUS_CORS_ORIGINS=http://localhost:3000

# Frontend (Next.js)
ARGUS_FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Gemini (the only LLM we use)
GEMINI_API_KEY=AIzaSyCeLMhdGqqO_PIv0yrx-uboIA_u134lj0Q
ARGUS_LLM_MODEL_PRIMARY=gemini-3-flash-preview
ARGUS_LLM_MODEL_FALLBACK=gemini-2.5-flash
ARGUS_LLM_MODEL_LAST_RESORT=gemini-2.5-flash-lite
ARGUS_EMBEDDING_MODEL=gemini-embedding-2

# Tambo (self-hosted; we use the OSS @tambo-ai/react SDK and call Gemini directly)
